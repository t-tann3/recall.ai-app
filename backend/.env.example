PORT=3001
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.dev
JWT_SECRET=replace-me-in-real-deploys

# Optional SQLite path (default: backend/data/shoptalk.sqlite)
# DATABASE_PATH=

# Recall.ai
# RECALL_REGION=us-west-2
# RECALL_API_KEY=
# RECALL_SVIX_WEBHOOK_SECRET=whsec_...
# RECALL_WORKSPACE_VERIFICATION_SECRET=

# Google Calendar OAuth (Settings → Calendar)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# CALENDAR_OAUTH_REDIRECT_URI=   # optional override; defaults to {PUBLIC_API_BASE_URL}/api/calendar/oauth/callback

# Optional LLM scorecards
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
